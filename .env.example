# Copier ce fichier en .env puis remplir les valeurs (le fichier .env n'est pas versionné).

# Base PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=api_produit

# Clé de signature des jetons JWT
# Générer une valeur avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changez-moi

# RabbitMQ (facultatif, guest/guest par défaut)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
